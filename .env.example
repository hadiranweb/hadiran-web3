# Local defaults. Production values live on Liara app `hadiranweb`, never in git.
# NEXT_PUBLIC_* is inlined at `next build` — set it on Liara before the first deploy.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMS.ir Verify (server-side only — never expose to the browser)
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_CODE_PARAMETER=CODE
SMSIR_TIMEOUT_MS=10000
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Comma-separated Iranian mobiles that become role=owner on first login
HADIRAN_OWNER_PHONES=
