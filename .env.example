# Local defaults. Production values live on Liara app `hadiranweb`, never in git.
# NEXT_PUBLIC_* is inlined at `next build` — set it on Liara before the first deploy.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMS.ir Verify (server-side only — never expose to the browser)
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_CODE_PARAMETER=CODE
SMSIR_TIMEOUT_MS=10000
# Optional reverse-proxy base if Liara cannot reach api.sms.ir (no trailing slash)
SMSIR_API_BASE=
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Comma-separated Iranian mobiles that become role=owner on first login
HADIRAN_OWNER_PHONES=

# Owner password for those phones — set on Liara only, never commit a real value
HADIRAN_OWNER_PASSWORD=

# HMAC secret for session JWT (HS256). Production refuses login if shorter than 32 chars.
# Same value on every Liara region / replica of app `hadiranweb`. Not a GitHub secret.
# Also wraps Telegram bot tokens at rest. Bot tokens themselves stay in Postgres, never in git.
# Generate: openssl rand -base64 48
HADIRAN_JWT_SECRET=

# Optional Telegram Bot API reverse-proxy if Liara cannot reach api.telegram.org (Iran datacenter).
# Cloudflare Worker URL, no trailing slash. Guide: docs/telegram-proxy.md
# Set on Liara only — not a GitHub secret. Bot tokens are not stored here.
TELEGRAM_API_BASE=

# Persistent Liara disk. Set on the Liara app console to the exact mount path you attached
# the disk to (Next.js prefers a project-relative path such as disk; absolute e.g. /app/disk
# is also accepted). Empty = no disk: built-in home SVG and generated avatars only.
# Never commit a real value. Code reads process.env.HADIRAN_DISK at runtime.
# Layout on the mount:
#   home/portrait.svg     homepage portrait (served at /media/home/portrait.svg)
#   avatars/<imageKey>    account profile photo bytes (imageKey in Postgres)
HADIRAN_DISK=

# Hadiran Studio (Puck page builder + site-page takeover). Owner-only; unset/false = fully off (404, no nav link, coded pages untouched).
HADIRAN_STUDIO_ENABLED=
